NODE_ENV="development"

PORT="8080"

DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

JWT_SECRET="your-secret-with-at-least-32-characters"
JWT_EXPIRES_IN="15m"

REFRESH_TOKEN_EXPIRES_IN_DAYS="30"

CORS_ORIGIN="http://localhost:3000"

# Login do admin (único). Gere o hash com: bun run hash-password
# No .env o $ do hash precisa de barra invertida (o script já imprime assim).
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD_HASH=""

# Cache das rotas publicas (opcional; sem REDIS_URL a leitura vai direto ao banco).
# Local: bun run docker:dev:up
# REDIS_URL="redis://localhost:6379"
# CACHE_TTL_SECONDS=604800

# URL publica das imagens (CloudFront), sem barra no final. Sem ela as imagens saem com url nula.
# CDN_URL="https://dxxxx.cloudfront.net"

# Upload de imagens (S3). Sem as tres variaveis o /admin/media responde 503.
# As credenciais AWS vem do ambiente (AWS_ACCESS_KEY_ID e AWS_SECRET_ACCESS_KEY).
# AWS_REGION="us-east-1"
# S3_BUCKET="meu-bucket"
# MEDIA_MAX_BYTES=5242880
