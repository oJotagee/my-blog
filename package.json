{
  "name": "blog",
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "bun run --filter '*' dev",
    "dev:api": "bun run --filter '@blog/api' dev",
    "dev:web": "bun run --filter '@blog/web' dev",
    "build:web": "bun run --filter '@blog/web' build",
    "docker:dev:up": "docker compose up -d",
    "docker:dev:down": "docker compose down",
    "hash-password": "bun run --filter '@blog/api' hash-password",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "db:generate": "bun --filter '@blog/api' db:generate",
    "db:migrate": "bun --filter '@blog/api' db:migrate",
    "db:studio": "bun --filter '@blog/api' db:studio"
  },
  "type": "module",
  "workspaces": [
    "api",
    "apps/*",
    "packages/*"
  ]
}
